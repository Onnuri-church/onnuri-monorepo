DATABASE_URL="postgresql://user:password@localhost:5432/onnuri?schema=public"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000

# 소셜 로그인 — 비워두면 토큰이 우리 앱에서 발급됐는지 검증(app_id/aud)을 건너뛴다.
# 로컬 개발용 허용이며 운영 배포 전 반드시 채운다.
# KAKAO_APP_ID: 카카오 developers 앱의 숫자 ID
# GOOGLE_CLIENT_IDS: 쉼표 구분 (Android/iOS 클라이언트 ID가 다르다)
KAKAO_APP_ID=""
GOOGLE_CLIENT_IDS=""

# 카카오 인가 코드 로그인(code 교환)용 — SDK 토큰 로그인만 쓰면 비워도 된다.
# KAKAO_CLIENT_SECRET은 카카오 콘솔 보안 메뉴에서 Client Secret을 활성화한 경우 필수.
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""

# 개발용 로그인(POST /auth/login/dev) — 소셜 SDK가 없는 웹/Expo Go 개발용.
# 로컬에서는 켜두고, 운영에서는 절대 켜지 않는다 (비우면 꺼짐 → 404).
AUTH_DEV_LOGIN="true"

# Sentry — 비워두면 에러 전송이 꺼진다 (로컬 개발 기본값)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
