# 복사해서 .env 생성. Expo는 EXPO_PUBLIC_ 접두사 변수만 클라이언트 번들에 노출한다.
# 이 파일(.env) 없이도 앱은 http://localhost:3000 기본값으로 동작한다 — 웹 미리보기·에뮬레이터용.

# 백엔드 API 주소. 실기기(Expo Go)에서는 localhost가 폰 자신을 가리키므로
# 개발 머신의 LAN IP로 바꾼다 (예: http://192.168.0.10:3000).
EXPO_PUBLIC_API_URL="http://localhost:3000"

# 소셜 로그인 SDK 키 — 값은 Jira 문서에 있다 (AGENTS.md "소셜 로그인 키" 참고).
# 카카오 네이티브 앱 키. config plugin이 빌드 시점에 읽으므로 빌드하는 환경에도 필요하다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=""
# 구글 웹 클라이언트 ID — SDK가 이 값을 aud로 ID 토큰을 발급받는다 (백엔드 GOOGLE_CLIENT_IDS와 일치 필요).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""

# 개발용 로그인 버튼 표시 여부. "true"일 때만 로그인 화면에 "[DEV] 개발용 로그인"이 나타난다.
# 실제로 동작하려면 백엔드도 AUTH_DEV_LOGIN=true여야 한다. 바꾸면 Metro 재시작 필요.
EXPO_PUBLIC_AUTH_DEV_LOGIN="true"
